{
  "rewrites": [
    { "source": "/api/admin/keys/:path*", "destination": "/api/admin/keys" },
    { "source": "/api/admin/:path*", "destination": "/api/admin/:path*" },
    { "source": "/api/license/:path*", "destination": "/api/license/:path*" },
    { "source": "/license/:path*", "destination": "/api/license/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-admin-password" }
      ]
    }
  ]
}
