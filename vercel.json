{
  "version": 2,
  "builds": [
    {
      "src": "web-admin-panel/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["web-admin-panel/public/**", "web-admin-panel/data/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "web-admin-panel/server.js"
    }
  ]
}
